@model List<OnlineWallet.Models.Transaction>

@{
    ViewData["Title"] = "Transações";
}

<div class="row">
    <div class="col-md-7">
        <ejs-grid id="transaction" dataSource="@Model" gridLines="None"
                  allowSorting="true" allowPaging="true">
            <e-grid-pagesettings pageSize="10"></e-grid-pagesettings>
            <e-grid-columns>
                <e-grid-column headerText="Titulo" field="Title" textAlign="Center" width="110px"></e-grid-column>
                <e-grid-column headerText="Valor" field="FormattedAmount" textAlign="Center" width="110px"></e-grid-column>
                <e-grid-column headerText="Data" field="Date" textAlign="Center" width="110px" type="date" format="dd/MM/yyyy"></e-grid-column>
                <e-grid-column headerText="Actions" template="#actionColumnTemplate" width="100px"></e-grid-column>
            </e-grid-columns>
        </ejs-grid>
    </div>
</div>


<script id="actionColumnTemplate" type="text/x-template">
    <div class="d-flex flex-row justify-content-start">
        <a class="btn btn-sm no-a-decoration" href="/Transaction/AddOrEdit/${TransactionId}">
            <i class="fa-solid fa-pen" style="color: #ffffff;"></i>
        </a>
        <form action="/Transactions/Delete/${TransactionId}" method="post">
            <button type="submit" class="btn btn-sm btn-link no-a-decoration">
                <i class="fa-solid fa-trash-can fa-lg text-danger"></i>
            </button>
        </form>
    </div>
</script>

